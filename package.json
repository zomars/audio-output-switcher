{
  "name": "audio-output-switcher",
  "version": "1.0.0",
  "description": "Switch the default audio output device from the Quick Access Menu.",
  "type": "module",
  "scripts": {
    "build": "shx rm -rf dist && rollup -c",
    "build:qam": "QAM_TAB=1 pnpm run build",
    "watch": "rollup -c -w"
  },
