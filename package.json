  "license": "MIT",
  "devDependencies": {
    "@decky/rollup": "^1.0.1",
    "@decky/ui": "^4.7.2",
    "@rollup/plugin-replace": "^6.0.1",
    "@types/react": "18.3.3",
    "rollup": "^4.22.5",
    "shx": "^0.3.4",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.2"
  }
}
